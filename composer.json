{
    "name": "dniccum/linear-sdk",
    "description": "A PHP SDK for creating Linear issues from your application's records. Framework-agnostic core with first-class Laravel support (Eloquent traits, queue jobs, facade and an optional branded configuration page).",
    "keywords": [
        "laravel",
        "symfony",
        "psr",
        "linear",
        "sdk",
        "issues",
        "eloquent"
    ],
    "homepage": "https://github.com/dniccum/linear-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Doug Niccum",
            "email": "doug@dniccumdesign.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "psr/event-dispatcher": "^1.0",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1||^2.0",
        "psr/log": "^1.1||^2.0||^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.10",
        "laravel/framework": "^12.0||^13.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^10.0||^11.0",
        "orchestra/workbench": "^10.0||^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "suggest": {
        "laravel/framework": "^12.0||^13.0: enables the Laravel integration (service provider, facade, Eloquent models and traits, queued jobs and the configuration page).",
        "symfony/http-client": "A PSR-18 HTTP client for non-Laravel applications (use it through Symfony\\Component\\HttpClient\\Psr18Client).",
        "nyholm/psr7": "PSR-17 request and stream factories for non-Laravel applications."
    },
    "conflict": {
        "laravel/framework": "<12.0"
    },
    "autoload": {
        "psr-4": {
            "Dniccum\\Linear\\": "src/",
            "Dniccum\\Linear\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dniccum\\Linear\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test": "vendor/bin/pest",
        "test-coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "@php -d memory_limit=-1 vendor/bin/pest --coverage --min=100"
        ],
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test",
        "check": [
            "@lint",
            "@analyse",
            "@test-coverage"
        ],
        "build": "npm run build",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench workbench:build --no-interaction",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dniccum\\Linear\\LinearServiceProvider"
            ],
            "aliases": {
                "Linear": "Dniccum\\Linear\\Facades\\Linear"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
