{
  "name": "@dniccum/linear-sdk-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Front-end bundle (TypeScript + Alpine.js) for the dniccum/linear-sdk Laravel package configuration page.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint resources/js",
    "lint:fix": "eslint resources/js --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "alpinejs": "^3.17.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/alpinejs": "^3.17.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
